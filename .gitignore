# Editors and OS
.idea/
.vscode/
.DS_Store

# Agent and scratch state
.claude/
*.log

# Local chain homes and release output
.earth/
release/

# Secrets never belong in this repo — the chain takes its config from config.yml
# locally and from the SDL's env block when deployed. A bare `.env` pattern once
# matched only that exact name, and a `.env.local` carrying a wallet mnemonic
# reached a public repository through the gap. `.env*` covers the family.
.env*

# Built binaries. `go build ./tools/poafixtures` drops one at the repo root; it is
# regenerable with `go run ./tools/poafixtures`.
/poafixtures
/earthd
*.test
*.out

# Native verifier libraries built by third_party/barretenberg-go/scripts/build-wrapper.sh.
# darwin_arm64 stays tracked — it is the development platform, and a fresh clone
# would otherwise have to fetch ~100MB from Aztec before it could build at all.
# Everything else is produced by CI per platform and must not be committed: each
# is ~50MB of object code.
third_party/barretenberg-go/lib/*
!third_party/barretenberg-go/lib/darwin_arm64/

# make proto-gen scratch
.proto-gen/
__pycache__/

# Genesis ceremony output (a fresh consensus key): never committed.
.ceremony/
